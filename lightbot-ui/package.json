{
  "name": "lightbot-ui",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"src/**/*.{vue,js,ts,css,scss,less,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{vue,js,ts,css,scss,less,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "cd .. && husky lightbot-ui/.husky"
  },
  "lint-staged": {
    "*.{vue,js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,less,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@antv/g6": "^5.1.1",
    "@tanstack/vue-virtual": "^3.13.29",
    "@vscode/markdown-it-katex": "^1.1.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.42.5",
    "@vue-flow/minimap": "^1.5.2",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.7.9",
    "cron-parser": "4.9.0",
    "dagre": "^0.8.5",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.11",
    "echarts": "^5.6.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "lucide-vue-next": "^0.577.0",
    "markdown-it": "^14.2.0",
    "markdown-it-task-lists": "^2.1.1",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.55.1",
    "pinia": "^2.3.0",
    "shiki": "^4.2.0",
    "tiny-pinyin": "^1.3.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "@types/dagre": "^0.7.54",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "less": "^4.6.4",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.5",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9",
    "vue-eslint-parser": "^9.4.3"
  }
}
