<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lightbot</groupId>
        <artifactId>lightbot</artifactId>
        <version>2.1.0</version>
    </parent>

    <artifactId>lightbot-tool</artifactId>
    <name>LightBot Tool</name>

    <properties>
        <graalvm.version>24.2.1</graalvm.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.lightbot</groupId>
            <artifactId>lightbot-knowledge</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 自动化定时任务 Tool 直接依赖 platform Service 接口 -->
        <dependency>
            <groupId>com.lightbot</groupId>
            <artifactId>lightbot-platform</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Janino Java 编译器（轻量级，~600KB） -->
        <dependency>
            <groupId>org.codehaus.janino</groupId>
            <artifactId>janino</artifactId>
            <version>3.1.12</version>
        </dependency>
        <!-- Groovy 脚本引擎（JSR-223） -->
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy-jsr223</artifactId>
            <version>4.0.26</version>
        </dependency>
        <!-- JSqlParser：SQL AST 解析，PgSqlTool 仅允许 SELECT 的权威校验；版本由父 pom dependencyManagement 统一锁定到 4.6 -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
        </dependency>

        <!-- ===== GraalVM Polyglot 沙盒（替换 Nashorn，可选 Python）=====
             纯 Java 内嵌，无需 OS 安装解释器；Context 级资源限制 + HostAccess.NONE 形成强隔离
             默认仅启用 JS（替换 Nashorn）；Python (GraalPy) 因 artifact 在不同 mirror 不稳定，
             不在 pom 强制声明，需启用时手动加入（GraalVmPythonEngine 会自动检测并启用）：
             <dependency>
                 <groupId>org.graalvm.polyglot</groupId>
                 <artifactId>polyglot</artifactId>
                 <version>${graalvm.version}</version>
             </dependency>
             <dependency>
                 <groupId>org.graalvm.python</groupId>
                 <artifactId>python-language</artifactId>
                 <version>${graalvm.version}</version>
             </dependency>
             <dependency>
                 <groupId>org.graalvm.python</groupId>
                 <artifactId>python-resource</artifactId>
                 <version>${graalvm.version}</version>
             </dependency>
        -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${graalvm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.graalvm.js</groupId>
            <artifactId>js-language</artifactId>
            <version>${graalvm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.graalvm.js</groupId>
            <artifactId>js-scriptengine</artifactId>
            <version>${graalvm.version}</version>
        </dependency>
    </dependencies>
</project>
